{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "almuerzo-misional",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Dominio temporal mientras se elige el definitivo. Al cambiarlo, dejar el viejo con un redirect
  // 301 que conserve la ruta: los links de /:barrio y /:barrio/m/:token ya circulan por WhatsApp.
  "routes": [{ "pattern": "almuerzo.ramonmartinez.dev", "custom_domain": true }],
  // Una sola dirección pública (sin *.workers.dev): la cookie de sesión y localStorage van por dominio.
  "workers_dev": false,
  "preview_urls": false,
  // El Worker responde /api/*; el resto lo sirve el build de React (SPA).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "almuerzo-misional",
      // La base de producción. En local wrangler usa una SQLite en .wrangler/.
      "database_id": "d3ccde12-e8e4-42d4-bbaa-81b8bf1c0b7e",
      "migrations_dir": "migrations"
    }
  ],
  // Anotarse desde el formulario público: 10 por minuto por IP (ver `limitarPorIp`).
  // namespace_id es un número propio de la cuenta, cualquiera que no use otro Worker.
  "ratelimits": [
    {
      "name": "LIMITE_INSCRIPCIONES",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGENES",
      "bucket_name": "almuerzo-misional-imagenes"
    }
  ]
}
