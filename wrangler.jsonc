{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "almuerzo-misional",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // El Worker responde /api/*; el resto lo sirve el build de React (SPA).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "almuerzo-misional",
      // Reemplazar con el id que entrega `bunx wrangler d1 create almuerzo-misional`.
      // En local no hace falta: wrangler usa una base SQLite en .wrangler/.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGENES",
      "bucket_name": "almuerzo-misional-imagenes"
    }
  ]
}
